GATEWAY_API_KEY=change-this-to-a-long-random-secret

# Provider 1: NVIDIA NIM
NVIDIA_API_KEY=
NVIDIA_API_KEYS=

# Provider 2: OpenCode Console (personal or service-account API key)
OPENCODE_API_KEY=

# Token saver: safe | balanced | off. Safe is the default.
FANTOM_TOKEN_SAVER=safe
# Code-generation style: off | lite | full | ultra. Off is the default.
FANTOM_CODE_MODE=off

FANTOM_BIND=127.0.0.1:8090
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
