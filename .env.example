GATEWAY_API_KEY=change-this-to-a-long-random-secret

# Provider credentials (also manageable from the Fantom dashboard after first login)
NVIDIA_API_KEY=
NVIDIA_API_KEYS=
OPENCODE_API_KEY=

# Gateway defaults
FANTOM_TOKEN_SAVER=safe
FANTOM_CODE_MODE=off
FANTOM_CAVEMAN_MODE=off

# Optional Headroom text compression service (disabled by default).
# The gateway POSTs to {FANTOM_HEADROOM_URL}/v1/compress and fails open on errors.
# User-authored message compression is a separate explicit opt-in.
FANTOM_HEADROOM_ENABLED=false
FANTOM_HEADROOM_URL=http://localhost:8787
FANTOM_HEADROOM_TIMEOUT_SECONDS=3
FANTOM_HEADROOM_COMPRESS_USER_MESSAGES=false

# Fail-fast in-flight caps. Excess inference traffic receives HTTP 503 + Retry-After.
FANTOM_MAX_CONCURRENT_REQUESTS=256
FANTOM_MAX_CONCURRENT_UPSTREAM_REQUESTS=512
FANTOM_MAX_CONCURRENT_PER_PROVIDER=64

FANTOM_DATA_DIR=/data

# Optional public management base URL. Some provider OAuth flows still require loopback callbacks.
FANTOM_PUBLIC_URL=
# Optional fixed secret for the loopback-only embedded router API.
# Leave empty to derive a stable private key from GATEWAY_API_KEY.
FANTOM_ROUTER_INTERNAL_KEY=

FANTOM_BIND=127.0.0.1:8090
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1
